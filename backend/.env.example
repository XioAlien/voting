# Copy to backend/.env and replace placeholders before starting local services.
# For local backend + dockerized dependencies use localhost; for future all-in-docker
# runtime switch DB_HOST/REDIS_HOST to mysql/redis.

MYSQL_PORT=3306
MYSQL_DATABASE=vote_db
MYSQL_USER=vote_app
MYSQL_PASSWORD=change_me_app_password
MYSQL_ROOT_PASSWORD=change_me_root_password

DB_HOST=localhost
DB_PORT=3306
DB_NAME=vote_db
DB_QUERY=useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_URL=
DB_USERNAME=vote_app
DB_PASSWORD=change_me_app_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

JWT_SECRET=change_me_jwt_secret_with_at_least_32_chars
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
INVITE_DEFAULT_MAX_MEMBERS=100
INVITE_CODE_LENGTH=8
DEV_TOKEN_ENABLED=false
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_MUST_CHANGE_PASSWORD=true

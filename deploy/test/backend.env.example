# Test environment example for Linux host deployment.
# Do not place production secrets in this file.
# Use test/staging infrastructure values, but keep `SPRING_PROFILES_ACTIVE=prod`
# in systemd so startup behavior stays close to the real production path.

DB_URL=jdbc:mysql://127.0.0.1:3306/vote_test?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_USERNAME=vote_test_app
DB_PASSWORD=__REPLACE_WITH_TEST_DB_PASSWORD__

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

JWT_SECRET=__REPLACE_WITH_TEST_JWT_SECRET__
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=https://vote-test.example.com
CORS_ALLOWED_ORIGIN_PATTERNS=

INVITE_DEFAULT_MAX_MEMBERS=100
INVITE_DEFAULT_EXPIRE_HOURS=168
INVITE_CODE_LENGTH=8

ENFORCE_SENSITIVE_CONFIG=true
DEV_TOKEN_ENABLED=false

# Keep enabled only during first deployment verification.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=test-admin
BOOTSTRAP_ADMIN_EMAIL=test-admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=__REPLACE_WITH_TEST_BOOTSTRAP_PASSWORD__
BOOTSTRAP_ADMIN_MUST_CHANGE_PASSWORD=true

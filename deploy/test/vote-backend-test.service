[Unit]
Description=Vote Backend Test Environment
After=network.target mysql.service redis.service
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/vote-test/backend
Environment=SPRING_PROFILES_ACTIVE=prod
ExecStart=/usr/bin/java -jar /srv/vote-test/backend/app.jar
SuccessExitStatus=143
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
